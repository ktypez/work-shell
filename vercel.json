{
  "rewrites": [
    { "source": "/api/truck-health", "destination": "https://truck-api-cf.fall3n.workers.dev/health" },
    { "source": "/api/truck/:path*", "destination": "https://truck-api-cf.fall3n.workers.dev/api/:path*" },
    { "source": "/api/data/:path*", "destination": "https://data-api.fall3n.workers.dev/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://me.mcky.space; frame-src 'self'; base-uri 'self'; form-action 'self'" }
    ] }
  ]
}
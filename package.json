    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@lucide/svelte": "^1.76.0",
    "@mcky/ui": "https://codeload.github.com/ktypez/mcky-ui/tar.gz/c7a3561b222cb89a4b52a9a631302e6fba519ea0"
  }
}